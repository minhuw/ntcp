+/*
+ * Author: xiaoj@google.com (Xiao Jia)
+ *
+ * Testing against a shared object (*.so) file.
+ */
+
+#include "so_testing.h"
+
+#include <dlfcn.h>
+#include <errno.h>
+#include <time.h>
+
+#include "logging.h"
+#include "netdev.h"
+#include "packetdrill.h"
+#include "run.h"
+
+typedef int (*send_segmented_t)(void *, const void *, size_t, u16);
+
+struct so_netdev {
+	struct netdev netdev;		/* "inherit" from netdev */
+	struct packetdrill_interface *ifc;	/* to be filled in later */
+	send_segmented_t send_segmented;
+	s64 receive_deadline; /* host monotonic usecs; zero means unbounded */
+};
+
+/* "Downcast" an abstract netdev to our flavor. */
+static inline struct so_netdev *to_so_netdev(struct netdev *netdev)
+{
+	return (struct so_netdev *)netdev;
+}
+
+static void so_netdev_free(struct netdev *a_netdev)
+{
+	struct so_netdev *netdev = to_so_netdev(a_netdev);
+
+	memset(netdev, 0, sizeof(*netdev));  /* paranoia */
+	free(netdev);
+}
+
+static int so_netdev_send(struct netdev *a_netdev, struct packet *packet)
+{
+	struct so_netdev *netdev = to_so_netdev(a_netdev);
+
+	assert(packet->ip_bytes > 0);
+	/* We do IPv4 and IPv6 */
+	assert(packet->ipv4 || packet->ipv6);
+	/* We only do TCP and ICMP */
+	assert(packet->tcp || packet->udp || packet->icmpv4 || packet->icmpv6);
+
+	/* Preserve original incoming segment size only when an aggregate
+	 * actually contains at least one full segment. Legacy raw ingress
+	 * cannot represent this metadata; never silently drop it. */
+	if (packet->tcp && packet->mss > 0 &&
+	    packet_payload_len(packet) >= packet->mss) {
+		if (!netdev->send_segmented || packet->mss > 65535) {
+			errno = EOPNOTSUPP;
+			return STATUS_ERR;
+		}
+		return netdev->send_segmented(netdev->ifc->userdata,
+			packet_start(packet), packet->ip_bytes, packet->mss);
+	}
+	return netdev->ifc->netdev_send(netdev->ifc->userdata,
+					packet_start(packet),
+					packet->ip_bytes);
+}
+
+/* Capture timestamps stay in the plugin's realtime domain. Only waiting uses
+ * the host monotonic clock; never use the plugin's script clock for deadlines. */
+static s64 receive_now(void)
+{
+	struct timespec now;
+	if (clock_gettime(CLOCK_MONOTONIC, &now))
+		return -1;
+	return (s64)now.tv_sec * 1000000 + now.tv_nsec / 1000;
+}
+
+int so_netdev_begin_receive(struct netdev *a_netdev, s32 timeout_secs,
+                           char **error)
+{
+	struct so_netdev *netdev = to_so_netdev(a_netdev);
+	netdev->receive_deadline = 0;
+	/* Match packet_socket_receive: zero and TIMEOUT_NONE are unbounded. */
+	if (timeout_secs <= 0)
+		return STATUS_OK;
+	s64 now = receive_now();
+	if (now < 0) {
+		asprintf(error, "capture clock_gettime: %s", strerror(errno));
+		return STATUS_ERR;
+	}
+	netdev->receive_deadline = now + (s64)timeout_secs * 1000000;
+	return STATUS_OK;
+}
+
+void so_netdev_end_receive(struct netdev *a_netdev)
+{
+	to_so_netdev(a_netdev)->receive_deadline = 0;
+}
+
+static int so_netdev_receive(struct netdev *a_netdev, s32 timeout_secs,
+                            struct packet **packet, char **error)
+{
+	struct so_netdev *netdev = to_so_netdev(a_netdev);
+	s64 now = receive_now();
+	if (now < 0) {
+		asprintf(error, "capture clock_gettime: %s", strerror(errno));
+		return STATUS_ERR;
+	}
+	s64 deadline = timeout_secs > 0 ?
+		now + (s64)timeout_secs * 1000000 : 0;
+	if (netdev->receive_deadline &&
+	    (!deadline || netdev->receive_deadline < deadline))
+		deadline = netdev->receive_deadline;
+	assert(*packet == NULL);
+	for (;;) {
+		now = receive_now();
+		if (now < 0) {
+			asprintf(error, "capture clock_gettime: %s", strerror(errno));
+			return STATUS_ERR;
+		}
+		if (deadline && now >= deadline)
+			return STATUS_TIMEOUT;
+		*packet = packet_new(PACKET_READ_BYTES);
+		size_t in_bytes = (*packet)->buffer_bytes;
+		errno = 0;
+		int status = netdev->ifc->netdev_receive(netdev->ifc->userdata,
+			(*packet)->buffer, &in_bytes, &((*packet)->time_usecs));
+		int saved_errno = errno;
+		if (status && saved_errno != EAGAIN && saved_errno != EWOULDBLOCK &&
+		    saved_errno != EINTR) {
+			asprintf(error, "netdev_receive failed (status %d, errno %d: %s)",
+				status, saved_errno, saved_errno ? strerror(saved_errno) :
+				"callback did not set errno");
+			packet_free(*packet);
+			*packet = NULL;
+			errno = saved_errno;
+			return STATUS_ERR;
+		}
+		if (!status && in_bytes) {
+			enum packet_parse_result_t result = parse_packet(*packet,
+				in_bytes, PACKET_LAYER_3_IP, error);
+			if (result == PACKET_OK)
+				return STATUS_OK;
+			if (result == PACKET_BAD) {
+				packet_free(*packet);
+				*packet = NULL;
+				return STATUS_ERR;
+			}
+			/* An unknown protocol is ignorable, but cannot reset the budget. */
+			free(*error);
+			*error = NULL;
+		}
+		packet_free(*packet);
+		*packet = NULL;
+		now = receive_now();
+		if (now < 0) {
+			asprintf(error, "capture clock_gettime: %s", strerror(errno));
+			return STATUS_ERR;
+		}
+		if (deadline && now >= deadline)
+			return STATUS_TIMEOUT;
+		/* At most 1 ms between polls, and never sleep past the deadline. */
+		s64 delay = deadline ? min((s64)1000, deadline - now) : 1000;
+		struct timespec pause = {.tv_sec = 0, .tv_nsec = delay * 1000};
+		nanosleep(&pause, NULL);
+	}
+}
+
+static struct netdev_ops so_netdev_ops = {
+	.free = so_netdev_free,
+	.send = so_netdev_send,
+	.receive = so_netdev_receive,
+};
+
+struct netdev *so_netdev_new(struct config *config)
+{
+	struct so_netdev *netdev = calloc(1, sizeof(struct so_netdev));
+
+	netdev->netdev.ops = &so_netdev_ops;
+	return (struct netdev *)netdev;
+}
+
+struct so_instance *so_instance_new(void)
+{
+	return calloc(1, sizeof(struct so_instance));
+}
+
+int so_instance_init(struct so_instance *instance,
+		     const struct config *config,
+		     const struct script *script,
+		     const struct state *state)
+{
+	packetdrill_interface_init_t init;
+	char *error;
+
+	instance->handle = dlopen(config->so_filename,
+				  RTLD_NOW | RTLD_LOCAL | RTLD_NODELETE |
+				  RTLD_DEEPBIND);
+	if (!instance->handle)
+		die("%s\n", dlerror());
+	dlerror();  /* clear any existing error */
+
+	init = dlsym(instance->handle, "packetdrill_interface_init");
+	error = dlerror();
+	if (error)
+		die("%s\n", error);
+
+	init(config->so_flags, &instance->ifc);
+	to_so_netdev(state->netdev)->ifc = &instance->ifc;
+	to_so_netdev(state->netdev)->send_segmented =
+		dlsym(instance->handle, "ntcp_packetdrill_net_send_segmented");
+	/* Absence is permitted for old raw-input plugins. */
+	dlerror();
+	return STATUS_OK;
+}
+
+void so_instance_free(struct so_instance *instance)
+{
+	if (!instance)
+		return;
+
+	instance->ifc.free(instance->ifc.userdata);
+
+	if (instance->handle)
+		dlclose(instance->handle);
+
+	memset(instance, 0, sizeof(*instance));
+	free(instance);
+}
