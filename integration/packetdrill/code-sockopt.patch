+/* Capture before tcp_convert_seq_number mutates the live sequence. Only
+ * fixed-size IPv4 headers fit the runner's existing 28-byte quote format. */
+static void remember_outbound_ip_header(struct socket *socket,
+                                       const struct packet *packet)
+{
+	socket->last_outbound_ipv4_valid = false;
+	if (packet->ipv4 && packet->tcp && packet->ipv4->ihl == 5 &&
+	    packet->ipv4->protocol == IPPROTO_TCP &&
+	    ntohs(packet->ipv4->tot_len) == sizeof(struct ipv4) +
+	        packet->tcp->doff * 4 + packet_payload_len(packet)) {
+		socket->last_outbound_ipv4_header = *packet->ipv4;
+		socket->last_outbound_ipv4_valid = true;
+	}
+}
+
+/* Only the unmodified constructor template is eligible. In particular,
+ * raw quotes and explicit checksum/length/header edits are not repaired. */
+static bool generated_icmpv4_quote(const struct packet *packet)
+{
+	return packet->icmpv4 && packet->echoed_header &&
+	       (packet->flags & FLAG_ICMP_ECHO_GENERATED) &&
+	       !memcmp(packet_echoed_ipv4_header(packet),
+	               &packet->generated_echo_ipv4, sizeof(struct ipv4));
+}
+
+static void complete_icmpv4_quote(struct socket *socket, struct packet *packet)
+{
+	struct ipv4 *quote = packet_echoed_ipv4_header(packet);
+	const struct ipv4 *ip = &socket->last_outbound_ipv4_header;
+	const struct tcp *tcp = &socket->last_outbound_tcp_header;
+	struct tcp *echo = packet_echoed_tcp_header(packet);
+
+	/* Keep explicit sequence and payload meaning, including deliberately
+	 * nonmatching quotes. Omission still maps sequence 0, as upstream does;
+	 * it is not permission to pick an unrelated last outbound sequence. */
+	if (echo && socket->last_outbound_ipv4_valid &&
+	    quote->src_ip.s_addr == ip->src_ip.s_addr &&
+	    quote->dst_ip.s_addr == ip->dst_ip.s_addr &&
+	    echo->src_port == tcp->src_port && echo->dst_port == tcp->dst_port &&
+	    echo->seq == tcp->seq &&
+	    ((packet->flags & FLAG_ICMP_ECHO_UNSPECIFIED) ||
+	     ntohs(quote->tot_len) - sizeof(struct ipv4) - sizeof(struct tcp) ==
+	     ntohs(ip->tot_len) - sizeof(struct ipv4) - tcp->doff * 4))
+		*quote = *ip;
+
+	/* Final live addresses and actual original total length, even though
+	 * only 28 bytes are included. There is no complete quoted TCP checksum
+	 * to calculate. send_live_ip_packet checksums enclosing ICMP afterwards. */
+	quote->check = 0;
+	quote->check = ipv4_checksum(quote, sizeof(*quote));
+}
