   +0...0.020 poll([{fd=4, events=POLLOUT, revents=POLLOUT}], 1, 1000) = 1
 +.005 < . 1:1(0) ack 1 win 0
 +.005 < . 1:1(0) ack 1 win 2000
   +0 > P. 1:2001(2000) ack 1
 +.010 < . 1:1(0) ack 2001 win 2000
   +0 > P. 2001:4001(2000) ack 1
   +0 poll([{fd=4, events=POLLOUT, revents=POLLOUT}], 1, 0) = 1
   +0 poll([{fd=4, events=POLLOUT, revents=POLLOUT}], 1, 0) = 1
// Refill the real2000-byte room and require a second blocked-to-writable cycle.
   +0 write(4, ..., 59000) = 2000
   +0 poll([{fd=4, events=POLLOUT, revents=0}], 1, 0) = 0
   +0...0.010 poll([{fd=4, events=POLLOUT, revents=POLLOUT}], 1, 1000) = 1
