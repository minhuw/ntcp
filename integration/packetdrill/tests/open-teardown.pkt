--ip_version=ipv4
--local_ip=192.0.2.1
--remote_ip=192.0.2.2

// Intentionally leave listener, accepted connection and fresh socket open.
0 socket(..., SOCK_STREAM, IPPROTO_TCP) = 3
+0 bind(3, ..., ...) = 0
+0 listen(3, 1) = 0
+0 < S 0:0(0) win 65535 <mss 1460,nop,wscale 0>
+0 > S. 0:0(0) ack 1 win 65535 <mss 1460,nop,wscale 0>
+0 < . 1:1(0) ack 1 win 65535
+0 accept(3, ..., ...) = 4
+0 socket(..., SOCK_STREAM, IPPROTO_TCP) = 5
