  "scope": "The ntcp-ported suite exclusively owns these source-derived accounting tests. The upstream suite excludes these source identities from execution and result counts; the two suites use the same common transport profile.",
  "scripts": {
    "timestamping/partial.pkt": {
      "source_sha256": "5a119eceac60170a8d3cc160c06ee272da119d63286ba1e1a9a87b992490038c",
      "input_generated_sha256": "cf0d84113668ac68912d0d951d2fc66cabd6592af0d8d70d2ab36fdf4242d57f",
      "fixture": "ntcp-expectations/timestamping/partial.pkt",
      "fixture_sha256": "f28fb0ba798027bad1f95e0cbdbc3656a45bb812cf93a6982abda8cd0c21d0b7",
      "rationale": "ntcp stores payload in a byte ring: SO_SNDBUF1000 becomes max(2*1000,4608)=4608 payload bytes, whereas Linux charges skb memory and this source expects2964. Exercise the same partial-write/last-byte timestamp contract using the native capacity.",
      "changes": [
        {
          "field": "nonblocking write return",
          "upstream": 2964,
          "ntcp": 4608,
          "derivation": "max(2*1000,4608); request10000 still exceeds capacity."
        },
        {
          "field": "initial peer SYN window",
          "upstream": 2000,
          "ntcp": 1976,
          "derivation": "2*(1000-12 timestamp option bytes); keep the initial receive window segment-aligned and avoid coupling timestamp assertions to Linux intermediate PUSH policy."
        },
        {
          "field": "second outbound aggregate / final ACK",
          "upstream": "1977:2965(988),ACK2965",
          "ntcp": "1977:4609(2632),ACK4609",
          "derivation": "Remaining4608-1976=2632 bytes; full-buffer finalization releases them after the20ms ACK."
        },
        {
          "field": "all3 timestamp ee_data IDs",
          "upstream": 2963,
          "ntcp": 4607,
          "derivation": "Last actually accepted byte:4608-1. SCHED/SND20ms,ACK30ms and RTT bounds unchanged."
        }
      ],
      "invariants": [
        "The write remains partial:4608 of10000, not a smaller full write.",
        "Contiguous data is fully acknowledged; ACKs never cover unsent bytes.",
        "All3 timestamp phases, option fields, packet payload and RTT assertions remain enabled.",
        "The final application PUSH remains checked; no runtime/profile/timestamp-counter changes."
      ]
    },
    "tcp_info/tcp-info-sndbuf-limited.pkt": {
      "source_sha256": "b210842cadfbc6d0ce1fee19afb3790dc9b9fe8c1fe02673288a646e3239e644",
      "input_generated_sha256": "0943bca391bead0d64d7d806c196afb51c50300dde35e503342d7501ad77fc92",
      "fixture": "ntcp-expectations/tcp_info/tcp-info-sndbuf-limited.pkt",
      "fixture_sha256": "8e8e4288eb7bdf6756352be6e7324179758c75fa123b79601003f6ac16d58c88",
      "rationale": "ntcp SO_SNDBUF10000 is20000 payload bytes. Unpaced HyStart++ and this hard capacity send10k,18k,then20k flights; the Linux source ACK30001/70001/95001 runs ahead. Use a60000-byte blocking workload and valid ACKs while retaining a genuine20ms buffer-starvation interval.",
      "changes": [
        {
          "field": "blocking write workload",
          "upstream": 150000,
          "ntcp": 60000,
          "derivation": "48k queued by120ms; final12k becomes admissible on the140ms ACK. The write still blocks until buffer space is freed."
        },
        {
          "field": "write return-time range",
          "upstream": "+.09...0.14",
          "ntcp": "+.09...0.13",
          "derivation": "Relative to prior10ms event, start100ms and finish140ms, matching the smaller workload."
        },
        {
          "field": "cumulative ACK timeline",
          "upstream": "110ms:10001,120ms:30001,130ms:70001,150ms:95001,170ms:150001",
          "ntcp": "110ms:10001,120ms:28001,140ms:48001,170ms:60001",
          "derivation": "Actual transmitted frontiers under20k capacity and10->18->26 MSS growth. Counter snapshots remain150ms and170ms."
        },
        {
          "field": "positive realtime sndbuf-limited bounds",
          "upstream": [
            19000,
            21000
          ],
          "ntcp": [
            16000,
            24000
          ],
          "derivation": "Expected20ms plus/minus the existing4000us packet-event tolerance, including asynchronous owner copy/output transition. Deterministic replay checks exactly20000us; zero still fails."
        }
      ],
      "invariants": [
        "Buffer starvation is required, not replaced with zero or an application-limited workload.",
        "The write remains blocking and exceeds the physical payload capacity.",
        "Both busy-time ranges remain49000..52000 and69000..73000; rwnd-limited remains0.",
        "All ACKs cover transmitted data; positive counter persists after the final ACK.",
        "No runtime, congestion-control, counter or profile changes."
      ]
    }
  },
